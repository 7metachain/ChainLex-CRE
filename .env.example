# Replace with your actual OpenRouter API key
OPENROUTER_API_KEY=""
# Neon connection string, e.g. postgres://user:password@host/db
NEON_DATABASE_URL=""

# Mock risk API base for /api/oracle/mock-assess forwarding
CHATBOT_API_BASE="http://localhost:8000"

# Oracle on-chain writeback (optional but required for closed loop)
ORACLE_WRITEBACK_RPC_URL=""
ORACLE_WRITEBACK_PRIVATE_KEY=""
ORACLE_CHAINLINK_RISK_ADDRESS=""
# Default: 11155111 (Sepolia)
ORACLE_WRITEBACK_CHAIN_ID="11155111"

# Foundry contract deployment API settings
FOUNDRY_PROJECT_ROOT=""
FOUNDRY_CONTRACT_TARGET="contracts/uRWA.sol:uRWA"
FOUNDRY_RPC_URL=""
FOUNDRY_PRIVATE_KEY=""
FOUNDRY_VERIFY="false"
FOUNDRY_ETHERSCAN_API_KEY=""
